#!/usr/bin/env bash
# Block any accidental commit of env files or key material.
blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env($|\.)|\.(pem|key|p12|pfx)$|credentials\.json$|google-token\.json$' | grep -v '\.env\.example$')
if [ -n "$blocked" ]; then
  echo "✖ pre-commit: refusing to commit secret-bearing files:" >&2
  echo "$blocked" | sed 's/^/    /' >&2
  echo "  (if this is intentional, use: git commit --no-verify)" >&2
  exit 1
fi
# Also block long-lived API key patterns in staged content.
if git diff --cached -U0 | grep -EI '(sk-[a-zA-Z0-9]{20,}|npg_[A-Za-z0-9]{12,}|AIza[0-9A-Za-z_\-]{30,})' >/dev/null 2>&1; then
  echo "✖ pre-commit: a staged file appears to contain an API key or DB password." >&2
  exit 1
fi
exit 0
