# =============================================================================
# Portfolio MIS Intelligence Dashboard — Environment Variables
# Copy to .env.local (in apps/web) and .env (in packages/db) for local dev.
# Real credentials must never be committed.
# =============================================================================

# Database (PostgreSQL with pgvector)
DATABASE_URL=

# Authentication (MVP single shared team password + signed cookie secret)
AUTH_PASSWORD=
COOKIE_SECRET=

# Embeddings (Gemini via @google/genai)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=

# Generation (DeepSeek via OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# App Port (optional, defaults to 3000)
PORT=
