# =============================================================================
# Portfolio MIS Intelligence Dashboard — Environment Configuration Template
# Copy to apps/web/.env.local and packages/db/.env for local development.
# Real credentials must never be committed to source control.
# =============================================================================

# --- Database Configuration (PostgreSQL 16+ with pgvector 0.8+) ---
# Local dev: postgresql://user:password@127.0.0.1:5432/mis_dashboard
# Production/Neon: postgresql://user:password@ep-xyz-pooler.region.neon.tech/mis_dashboard?sslmode=require
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/mis_dashboard

# (Optional) Direct read-only connection to WEH CRM database for seeding portfolio companies
CRM_DATABASE_URL=postgresql://readonly_user:password@crm-db.example.com/crm_production

# (Optional) Path to external CRM .env file if CRM_DATABASE_URL is not set directly
CRM_ENV_PATH=/path/to/crm/.env

# --- Authentication & Session Security ---
# Shared team credentials for MVP access control
AUTH_USERNAME=wehcrm
AUTH_PASSWORD=your_secure_team_password_here

# Minimum 32-character secret key for HMAC-SHA256 session cookie signing (generate with: openssl rand -hex 32)
COOKIE_SECRET=replace_with_a_secure_random_32_plus_character_string

# --- Embeddings (Google Gemini API via @google/genai) ---
# Google Gemini API key with embedding access
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini embedding model identifier (defaults to gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# pgvector embedding dimensions (1536 for gemini-embedding-001)
EMBEDDING_DIMENSIONS=1536
# Rate limit delay between embedding batches in milliseconds (optional, defaults to 1000)
EMBED_DELAY_MS=1000

# --- Generation & RAG Reasoning (DeepSeek via OpenAI-compatible endpoint) ---
# DeepSeek API key for structured extraction and RAG reasoning
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DeepSeek API base URL (defaults to https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek model identifier (defaults to deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# --- Application URLs & Server Settings ---
# Public URL for base redirects and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server port (optional, defaults to 3000)
PORT=3000

# --- Verification & E2E Testing Overrides (Optional) ---
# Optional username override for headless verification scripts
MIS_AUTH_USERNAME=wehcrm
# Optional password override for headless verification scripts (never commit real value)
MIS_AUTH_PASSWORD=your_secure_team_password_here
# Optional base URL for E2E tests (defaults to http://localhost:3000)
TEST_URL=http://localhost:3000
