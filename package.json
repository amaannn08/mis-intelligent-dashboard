{
  "name": "mis-intelligent-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=@mis/db",
    "db:migrate": "npm run db:migrate --workspace=@mis/db",
    "db:studio": "npm run db:studio --workspace=@mis/db",
    "db:seed": "npm run db:seed --workspace=@mis/db",
    "db:seed:crm": "npm run db:seed:crm --workspace=@mis/db",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "ingest:gdrive": "tsx scripts/ingest-gdrive.ts",
    "blob:repair": "tsx scripts/repair-blobs.ts",
    "test": "npm run scan:secrets && vitest run"
  },
  "devDependencies": {
    "puppeteer-core": "^25.11.0",
    "vitest": "^5.0.1"
  }
}
