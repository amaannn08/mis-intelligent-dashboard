# ---------------------------------------------------------------------------
# SECRETS — never commit these. Real values live in the gitignored env files.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
!.env.example

# Per-workspace env files
apps/*/.env
apps/*/.env.*
packages/*/.env
packages/*/.env.*
!apps/*/.env.example
!packages/*/.env.example

# credentials / keys that must never land in git
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-token.json
google-token.json

# ---------------------------------------------------------------------------
# Node / monorepo
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------
.next/
out/
build/
dist/
.swc/
next-env.d.ts
.vercel
.turbo/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Testing / tooling caches
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
.eslintcache
.cache/
*.log

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---------------------------------------------------------------------------
# Uploaded MIS documents & local scratch data — user content, not source
# ---------------------------------------------------------------------------
uploads/
/storage/
/scratch/
/tmp/
